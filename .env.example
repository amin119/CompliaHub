# Copy this file to .env and adjust if you like. These values are picked up by
# docker-compose.yml to configure the 5 local infra containers.

# --- Postgres: relational metadata store (documents, chunks, job state) ---
POSTGRES_USER=compliancegraph
POSTGRES_PASSWORD=compliancegraph_dev
POSTGRES_DB=compliancegraph
POSTGRES_PORT=5432

# --- Redis: cache + Celery broker/result backend ---
REDIS_PORT=6379

# --- Neo4j: knowledge graph store ---
NEO4J_USER=neo4j
NEO4J_PASSWORD=compliancegraph_dev
NEO4J_HTTP_PORT=7474
NEO4J_BOLT_PORT=7687

# --- Qdrant: vector store ---
QDRANT_HTTP_PORT=6333
QDRANT_GRPC_PORT=6334

# --- MinIO: S3-compatible object storage for raw uploaded documents ---
MINIO_ROOT_USER=compliancegraph
MINIO_ROOT_PASSWORD=compliancegraph_dev
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001

# --- Voyage: embeddings, used by the worker's embed_chunks_task stage ---
# Must match backend/.env's VOYAGE_API_KEY — the worker container reads this
# file (via docker-compose.yml), the host FastAPI process reads backend/.env.
VOYAGE_API_KEY=
VOYAGE_MODEL=voyage-law-2
