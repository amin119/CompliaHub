# Copy to backend/.env. Values here match docker-compose's defaults so the app
# can talk to the containers from Step 2 without any extra setup.

APP_ENV=development

# Postgres (psycopg2 / SQLAlchemy-style URL)
DATABASE_URL=postgresql://compliancegraph:compliancegraph_dev@localhost:5432/compliancegraph

# Redis (cache + future Celery broker)
REDIS_URL=redis://localhost:6379/0

# Neo4j (bolt is the driver protocol, not the browser port)
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=compliancegraph_dev

# Qdrant
QDRANT_URL=http://localhost:6333

# MinIO (S3-compatible)
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=compliancegraph
MINIO_SECRET_KEY=compliancegraph_dev
MINIO_SECURE=false

# Frontend origin allowed to call this API
CORS_ORIGINS=["http://localhost:3000"]

# Phase 2 — vector layer (embeddings / reranking / answer generation)
VOYAGE_API_KEY=
VOYAGE_MODEL=voyage-law-2
COHERE_API_KEY=
COHERE_RERANK_MODEL=rerank-v3.5
GROK_API_KEY=
GROK_BASE_URL=https://api.x.ai/v1
ANSWER_MODEL=grok-4.5

# Phase 3 — entity/relation extraction (Gemini free tier). Not needed on the
# host — see root .env.example's note on the extraction key.
GEMINI_API_KEY=
GEMINI_EXTRACTION_MODEL=gemini-3.1-flash-lite
